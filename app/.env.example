# Copiar a .env.local y completar.
# .env.local NUNCA se commitea.

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Wapu API ---
# Base URL de la API Wapu. La API key del usuario NO va acá,
# se ingresa en onboarding y se cifra client-side.
#
# Dev local: URL absoluta a Wapu (sin proxy). Si CORS te rompe en local,
#            podés usar el proxy de Vite (no configurado por defecto).
# Producción (Vercel): "/api/wapu" — el rewrite definido en vercel.json
#            proxea esa ruta a https://be-stage.wapu.app y evita CORS.
VITE_WAPU_API_BASE_URL=https://be-stage.wapu.app
